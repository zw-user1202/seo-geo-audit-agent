# DeepSeek API Key（必填，SEO / GEO AI 分析调用）
DEEPSEEK_API_KEY=

# 会话签名密钥（生产环境必填；开发环境不填则回退到内置开发密钥）
SESSION_SECRET=

# 服务端口（默认 3000）
PORT=3000

# 首次启动引导管理员（仅当用户表为空时自动创建；密码至少 12 位）
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

# 日志级别（默认 info）
LOG_LEVEL=info

# 运行环境（生产环境使用 production）
NODE_ENV=development
