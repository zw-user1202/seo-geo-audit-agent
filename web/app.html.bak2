<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>审核工作台 - SEO & GEO</title>
<link rel="icon" href="/favicon.jpg" type="image/jpeg">
<style>
:root{font-family:"PingFang SC","Microsoft YaHei",Arial,sans-serif;color:#1a1a1a;background:#fff;letter-spacing:0}
*{box-sizing:border-box;margin:0;padding:0}body{min-height:100vh;display:flex;flex-direction:column}
a{color:inherit;text-decoration:none}
.site-header{position:sticky;z-index:50;top:0;display:flex;width:min(1200px,calc(100% - 48px));min-height:72px;align-items:center;margin:0 auto;background:#fffffff0;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid rgba(26,26,26,.12)}
.wordmark{display:inline-flex;align-items:center;gap:12px;text-decoration:none}
.wordmark-name{font-size:28px;font-weight:650;line-height:1}
.site-nav{display:flex;align-items:center;gap:20px;margin-left:auto}
.site-nav a,.site-nav button{font-size:13px;font-weight:500;background:none;border:none;color:#1a1a1a;cursor:pointer;padding:0;position:relative}
.site-nav a:after,.site-nav button:after{position:absolute;right:0;bottom:-6px;left:0;height:1px;content:"";background:var(--ink);transform:scaleX(0);transform-origin:left;transition:transform .18s ease}
.site-nav a:hover:after,.site-nav button:hover:after{transform:scaleX(1)}
.nav-user{display:flex;align-items:center;gap:6px;font-size:12px;color:#74746f;padding:4px 10px;border:1px solid rgba(26,26,26,.12);border-radius:6px}
.nav-user span{font-family:monospace;color:var(--ink)}
.nav-logout{color:var(--muted)!important}.nav-logout:hover{color:#c53030!important}
.main-content{flex:1;width:min(1200px,calc(100% - 48px));margin:0 auto;padding:48px 0 80px}
.intro{margin-bottom:48px}
.intro-eyebrow{color:var(--muted);font-family:monospace;font-size:10px;font-weight:500;text-transform:uppercase;margin-bottom:18px}
.intro h1{font-size:clamp(32px,5vw,52px);font-weight:560;line-height:1.1;margin-bottom:12px}
.intro>p{color:var(--muted);font-size:16px;line-height:1.7;max-width:600px}
.intro-stats{display:flex;gap:32px;margin-top:24px;padding-top:24px;border-top:1px solid var(--line)}
.intro-stats div span{display:block;font-size:11px;color:var(--faint);font-family:monospace;text-transform:uppercase}
.intro-stats div strong{display:block;margin-top:4px;font-size:15px;font-weight:600}

/* Form Panel */
.panel{border:1px solid rgba(26,26,26,.12);border-radius:8px;padding:32px;margin-bottom:32px}
.panel-label{color:var(--muted);font-family:monospace;font-size:10px;font-weight:500;text-transform:uppercase;margin-bottom:18px}
.panel h2{font-size:22px;font-weight:600;margin-bottom:8px}
.panel>p{color:var(--muted);font-size:14px;line-height:1.6;margin-bottom:24px}

/* Mode Toggle */
.mode-row{display:flex;align-items:center;gap:12px;margin-bottom:20px;flex-wrap:wrap}



.mode-pill{font-size:11px;color:var(--faint);font-family:monospace}

/* Form Fields */
.form-grid{display:grid;grid-template-columns:1fr 1fr 3fr;gap:16px;margin-bottom:20px}
.form-label{display:block;font-size:12px;font-weight:600;margin-bottom:6px;color:var(--ink)}
.form-input,.form-select{width:100%;height:44px;padding:0 14px;border:1px solid rgba(26,26,26,.12);border-radius:6px;font-size:14px;color:#1a1a1a;background:#fff;outline:none;transition:border-color .15s}
.form-input:focus,.form-select:focus{border-color:#1a1a1a}
.form-input::placeholder{color:var(--faint)}
textarea.form-input{height:auto;padding:12px 14px;resize:vertical}

/* Scope */
.scope-row{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap}
.scope-check{display:flex;align-items:center;gap:8px;padding:10px 16px;border:1px solid rgba(26,26,26,.12);border-radius:6px;font-size:13px;cursor:pointer;transition:all .15s}
.scope-check:has(input:checked){border-color:#1a1a1a;background:#fafafa}
.scope-check input{accent-color:#1a1a1a}

/* Submit */
.btn-submit{width:100%;height:52px;border:none;border-radius:6px;background:#1a1a1a;color:#fff;font-size:15px;font-weight:600;cursor:pointer;transition:opacity .15s;display:flex;align-items:center;justify-content:center;gap:8px}
.btn-submit:hover{opacity:.85}
.btn-submit:disabled{opacity:.5;cursor:not-allowed}

/* Progress */
.progress-panel{margin-top:24px;padding:20px;border:1px solid var(--line);border-radius:6px;display:none}
.progress-panel.show{display:block}
.progress-bar{height:4px;background:var(--line);border-radius:2px;overflow:hidden}
.progress-bar-fill{height:100%;background:var(--ink);border-radius:2px;transition:width .3s}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid var(--line);border-top-color:var(--ink);border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* Output Preview */
.output-list{display:flex;flex-direction:column}
.output-item{display:flex;align-items:flex-start;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
.output-item:last-child{border:none}
.output-num{font-family:monospace;font-size:12px;color:var(--faint);min-width:24px;padding-top:2px}
.output-item strong{display:block;font-size:15px;margin-bottom:4px}
.output-item p{font-size:13px;color:var(--muted);line-height:1.5}

/* Recent Reports */
.report-list{display:flex;flex-direction:column}
.report-empty{padding:20px 0;text-align:center;color:var(--faint);font-size:13px}
.report-item{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--line)}
.report-item:last-child{border:none}
.report-item span{font-size:13px;color:var(--muted)}
.report-item a{font-size:13px;font-weight:500}
.report-item a:hover{text-decoration:underline}

/* Signals */
.signal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0}
.signal-item{display:flex;align-items:center;gap:10px;padding:14px 0;border-bottom:1px solid var(--line);font-size:14px}
.signal-item:nth-child(odd){padding-right:16px}
.signal-item:nth-child(even){padding-left:16px;border-left:1px solid var(--line)}
.signal-icon{color:var(--faint);font-size:14px}

/* Agent Workspace */
.agent-workspace{margin-top:24px;display:none}
.agent-workspace.show{display:block}
.agent-status{padding:20px;border:1px solid var(--line);border-radius:6px;margin-bottom:16px}
.agent-status-title{font-family:monospace;font-size:10px;color:var(--faint);text-transform:uppercase;margin-bottom:8px}
.agent-status-text{font-size:14px;font-weight:500;margin-bottom:12px}
.btn-cancel{padding:8px 16px;border:1px solid var(--line);border-radius:6px;background:none;font-size:13px;cursor:pointer;color:var(--muted);transition:all .15s;margin-top:12px}
.btn-cancel:hover{border-color:#c53030;color:#c53030}
.agent-report-link{display:none;margin-top:12px;font-size:13px;font-weight:500}
.agent-report-link.show{display:inline-flex;align-items:center;gap:6px}
.agent-timeline{display:flex;flex-direction:column;gap:8px}
.timeline-item{display:flex;align-items:flex-start;gap:10px;font-size:13px;padding:8px 0}
.timeline-dot{width:8px;height:8px;border-radius:50%;background:var(--line);margin-top:5px;flex-shrink:0}
.timeline-dot.done{background:var(--ink)}

/* Footer */
.site-footer{border-top:1px solid var(--line);padding:32px 0;text-align:center}
.site-footer p{font-size:11px;color:var(--faint);font-family:monospace}

/* Grid Layout */
.two-col{display:grid;grid-template-columns:3fr 2fr;gap:32px;margin-bottom:32px}
.secondary-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px}

/* Hidden */
.hidden{display:none!important}

@media(max-width:768px){
.form-grid{grid-template-columns:1fr}
.two-col,.secondary-grid{grid-template-columns:1fr}
.signal-item:nth-child(even){padding-left:0;border-left:none}
.intro-stats{flex-wrap:wrap;gap:16px}
}

/* Recent Reports */
.recent-report-item{display:flex;align-items:center;justify-content:space-between;width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:6px;background:none;cursor:pointer;text-align:left;transition:all .15s;margin-bottom:8px}
.recent-report-item:hover{border-color:var(--ink);background:#fafafa}
.recent-report-item:last-child{margin-bottom:0}
.recent-report-main{display:flex;flex-direction:column;gap:4px;min-width:0;flex:1}
.recent-report-main span{font-size:13px;font-weight:500;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recent-report-main small{font-size:11px;color:var(--faint);font-family:monospace}
.recent-report-score{flex-shrink:0;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:15px;font-weight:700;font-family:monospace}
.recent-report-score.good{background:#f0fdf4;color:#16a34a}
.recent-report-score.warning{background:#fffbeb;color:#d97706}
.recent-report-score.danger{background:#fef2f2;color:#dc2626}

/* Signal Grid v2 */
.signal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.signal-card{display:flex;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--line);border-radius:6px;transition:all .15s}
.signal-card:hover{border-color:var(--ink)}
.signal-icon{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:#f8f9fa;border-radius:6px;font-size:14px;color:var(--ink);flex-shrink:0}
.signal-text{font-size:13px;font-weight:500;color:var(--ink)}

/* Fix mode button jumping */



.mode-btns 


/* Mode Toggle - Fixed */
.mode-btns{display:flex;border:1px solid rgba(26,26,26,.12);border-radius:999px;overflow:hidden}
.mode-btns .mode-button{padding:8px 20px;font-size:13px;font-weight:500;background:none!important;border:none!important;border-radius:999px!important;cursor:pointer;color:#74746f!important;line-height:1.4}
.mode-btns .mode-button.is-active{background:#1a1a1a!important;color:#fff!important}
.mode-pill{font-size:11px;color:var(--faint);font-family:monospace}
</style>
</head>
<body id="appBody">

<header class="site-header">
<a href="/" class="wordmark"><span class="wordmark-name">SEO & GEO</span></a>
<nav class="site-nav">
<a href="history.html">历史</a>
<a href="admin.html" id="adminPanelBtn" class="hidden">管理</a>
<div class="nav-user">👤 <span id="currentUsername">-</span></div>
<button onclick="logout()" class="nav-logout">退出</button>
</nav>
</header>

<main class="main-content">
<!-- Intro -->
<div class="intro">

<h1>审核工作台</h1>
<p>输入目标 URL，生成搜索可见性、AI 可读性和优先修复建议。</p>
<div class="intro-stats">
<div><span>报告结构</span><strong>5 个模块</strong></div>
<div><span>审核范围</span><strong>SEO & GEO</strong></div>
<div><span>处理方式</span><strong>单页优先</strong></div>
</div>
</div>

<!-- Two Column Layout -->
<div class="two-col">
<!-- Left: Form -->
<div>
<div class="panel">
<div class="panel-label">开始审核</div>
<h2>输入页面地址</h2>
<p>建议先审核核心落地页、产品页或内容页。</p>

<div class="mode-row">
<div class="mode-btns">
<button id="singleModeBtn" class="mode-button is-active" type="button">单个 URL</button>
<button id="batchModeBtn" class="mode-button" type="button">批量分析</button>
</div>
<span class="mode-pill">安全抓取</span>
</div>

<form id="seoAuditForm">
<div class="form-grid">
<div>
<label class="form-label">抓取身份</label>
<select id="ua" class="form-select">
<option value="pc">PC</option>
<option value="google">Googlebot</option>
<option value="baidu">Baiduspider</option>
<option value="baidu-mobile">Baidu Mobile</option>
<option value="mobile">Mobile</option>
</select>
</div>
<div>
<label class="form-label">AI 引擎</label>
<select id="aiProvider" class="form-select">
<option value="deepseek">DeepSeek</option>
<option value="doubao">豆包</option>
<option value="qianwen">千问</option>
<option value="yuanbao">元宝</option>
</select>
</div>
<div>
<label class="form-label">目标 URL</label>
<div id="urlInputContainer">
<input type="text" id="url" name="url" required placeholder="" class="form-input">
</div>
<div id="batchUrlsContainer" class="hidden">
<textarea id="batchUrls" name="urls" rows="4" placeholder="每行一个 URL" class="form-input"></textarea>
</div>
</div>
</div>

<div class="scope-row">
<label class="scope-check"><input type="checkbox" id="scopeSeo" checked> SEO 基础审核</label>
<label class="scope-check"><input type="checkbox" id="scopeGeo" checked> GEO 可见性审核</label>
</div>

<button type="submit" id="analyzeBtn" class="btn-submit">开始审核</button>
</form>

<div id="loadingIndicator" class="progress-panel">
<div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:16px">
<div class="spinner"></div>
<span id="loadingText" style="font-size:13px;color:var(--muted)">处理中...</span>
</div>
<div id="progressContainer" class="hidden">
<div class="progress-bar" style="margin-bottom:12px"><div id="progressBar" class="progress-bar-fill" style="width:0%"></div></div>
<div id="progressText" style="text-align:center;font-size:12px;color:var(--muted);margin-bottom:12px;font-family:monospace"></div>
<div id="progressSteps" style="max-height:140px;overflow-y:auto"></div>
</div>
</div>

<div id="agentWorkspace" class="agent-workspace">
<div class="agent-status">
<div class="agent-status-title">审核进度</div>
<div id="agentStatusText" class="agent-status-text">等待启动</div>
<div class="progress-bar"><div id="agentProgressBar" class="progress-bar-fill" style="width:0%"></div></div>
<button id="cancelJobBtn" class="btn-cancel hidden" onclick="cancelCurrentJob()">取消任务</button>
<a id="agentReportLink" class="agent-report-link hidden" href="#">打开报告</a>
</div>
<div id="agentTimeline" class="agent-timeline"></div>
</div>
</div>
</div>

<!-- Right: Output Preview -->
<div>
<div class="panel">
<div class="panel-label">报告内容</div>
<h2>审核完成后会看到什么</h2>
<p>结果按"结论、指标、修复、详情、证据"组织。</p>
<div class="output-list">
<div class="output-item"><span class="output-num">01</span><div><strong>总览结论</strong><p>综合健康度、SEO 分数和 GEO 分数。</p></div></div>
<div class="output-item"><span class="output-num">02</span><div><strong>优先修复</strong><p>按影响程度排序的处理事项。</p></div></div>
<div class="output-item"><span class="output-num">03</span><div><strong>页面证据</strong><p>Title、Meta、正文、Schema 等判断来源。</p></div></div>
</div>
</div>
</div>
</div>

<!-- Secondary Grid -->
<div class="secondary-grid">
<div class="panel">
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
<div>
<div class="panel-label">最近报告</div>
<h2>继续查看历史审核</h2>
</div>
<a href="history.html" style="font-size:13px;font-weight:500">全部历史</a>
</div>
<div id="recentReportsContainer" class="report-list">
<div class="report-empty">正在加载最近报告...</div>
</div>
</div>

<div class="panel">
<div class="panel-label">审核范围</div>
<h2 style="margin-bottom:16px">覆盖的核心信号</h2>
<div class="signal-grid">
<div class="signal-card"><div class="signal-icon">H</div><div class="signal-text">Title / Meta / Heading</div></div>
<div class="signal-card"><div class="signal-icon">⟶</div><div class="signal-text">链接与图片信号</div></div>
<div class="signal-card"><div class="signal-icon">&lt;/&gt;</div><div class="signal-text">Schema / robots / sitemap</div></div>
<div class="signal-card"><div class="signal-icon">?</div><div class="signal-text">可摘取答案与 FAQ</div></div>
</div>
</div>
</div>
</main>

<footer class="site-footer">

</footer>

<script src="js/utils.js"></script>
<script src="js/api.js"></script>
<script src="js/auth.js"></script>
<script src="js/home.js"></script>
<script>
window.addEventListener('pageshow', async function(e) {
    try {
        const resp = await fetch('/api/check-session', { credentials: 'include' });
        if (!resp.ok) { window.location.replace('/login.html'); return; }
        const data = await resp.json();
        sessionStorage.setItem('user', JSON.stringify(data.user));
        document.getElementById('currentUsername').textContent = data.user.username;
        if (data.user.role === 'admin') {
            document.getElementById('adminPanelBtn').classList.remove('hidden');
        }
        if (window.loadHomeRecentReports) {
            window.loadHomeRecentReports();
        }
    } catch (err) {
        window.location.replace('/login.html');
    }
});
</script>
</body>
</html>

